# Carpeta de configuración interna del editor (cache, importados, etc.)
.godot/

# Archivos generados por importación (NO versionar)
.import/
*.import

# Archivos de exportación temporales
export.cfg
export_presets.cfg

# =========================
# BUILDS / EXPORTS
# =========================

# Builds de exportación
/android/
/ios/
/html/
/windows/
/linux/
/macos/

# Archivos exportados
*.apk
*.aab
*.ipa
*.exe
*.zip
*.tar.gz

# =========================
# CACHE / TEMP
# =========================

# Cachés del sistema
.cache/
tmp/
temp/

# Archivos temporales del sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# =========================
# LOGS
# =========================

*.log

# =========================
# IDEs / EDITORES
# =========================

# Visual Studio Code
.vscode/

# JetBrains (IntelliJ, Rider, etc.)
.idea/

# Archivos de workspace
*.code-workspace

# =========================
# LENGUAJES / TOOLS EXTRA
# =========================

# Mono / C#
.mono/
*.csproj
*.sln
*.user
*.dll
*.exe
*.mdb
*.pdb

# =========================
# TEST / DEBUG
# =========================

# Dumps / debugging
*.stackdump

# =========================
# OTROS
# =========================

# Backups
*~
*.bak
*.tmp

# Archivos de usuario (config local)
*.local
# =========================
# ASSETS CRUDOS CON LICENCIA RESTRICTIVA (solo locales)
# =========================
# Super Pixel Effects (unTied Games) prohíbe redistribuir el pack crudo, en todo o en parte.
# Se versionan solo license/readme/guide y los assets curados en assets/art/vfx.
assets/art/_source/super_pixel_effects/PNG/
assets/art/_source/super_pixel_effects/spritesheet/
# Raven Fantasy Icons: licencia desconocida; se versionan solo los íconos usados (assets/art/ui).
assets/art/_source/raven_fantasy_icons/
# FX rechazados (copia local del pack FX, mismo motivo de licencia)
assets/art/_rejected/vfx/

# Logs del editor/juego
godot_debug_output.txt
