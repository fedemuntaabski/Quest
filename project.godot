; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="QUEST"
config/version="1.0"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/image="uid://cdg3ntj0dgxe5"
config/icon="uid://csy67bd45j2vb"
boot_splash/minimum_display_time=2000

[autoload]

PlayerStats="*res://scripts/core/stats/PlayerStats.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
ThemeManager="*res://scripts/core/theme/ThemeManager.gd"
SettingsManager="*res://scripts/managers/SettingsManager.gd"
FPSOverlay="*res://scripts/ui/overlays/FPSOverlay.gd"
SteamManager="*res://scripts/network/SteamManager.gd"
ResourceManager="*res://scripts/managers/ResourceManager.gd"
GameSession="*res://scripts/managers/GameSession.gd"
SelectionManager="*res://scripts/managers/SelectionManager.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
mouse_cursor/tooltip_position_offset=Vector2(0, 0)

