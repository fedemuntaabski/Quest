[gd_resource type="Resource" script_class="DifficultyConfig" format=3]

[ext_resource type="Script" path="res://scripts/core/floors/DifficultyConfig.gd" id="1_cfg"]
[ext_resource type="Script" path="res://scripts/core/floors/DifficultyLevel.gd" id="2_level"]

[sub_resource type="Resource" id="normal"]
script = ExtResource("2_level")
id = "normal"
display_name = "Normal"
description = "La mazmorra tal como fue pensada."

[sub_resource type="Resource" id="hard"]
script = ExtResource("2_level")
id = "hard"
display_name = "Difícil"
description = "Enemigos más duros y numerosos, menos recursos al empezar y un Nexo más frágil."
hp_mult = 1.35
damage_mult = 1.25
threat_mult = 1.25
extra_max_enemies = 2
nexo_hp_mult = 0.8
start_resource_mult = 0.75

[resource]
script = ExtResource("1_cfg")
levels = Array[ExtResource("2_level")]([SubResource("normal"), SubResource("hard")])
