[sub_resource type="Resource" id="Resource_start"]
script = ExtResource("2_vis")
type = 1
display_name = "Inicio"
color = Color(0.9, 0.9, 0.9, 1)
show_marker = false

[sub_resource type="Resource" id="Resource_exit"]
script = ExtResource("2_vis")
type = 2
display_name = "Salida"
banner_text = "Salida encontrada"
description = "Lleva el Nexo hasta aquí para ganar el piso."
hint = "La salida del piso. Recoge el Nexo en la sala inicial y llévalo hasta aquí. Mientras lo cargas las puertas se bloquean y llegan oleadas por las salas oscuras."
color = Color(0.35, 1, 0.6, 1)
show_marker = false

[sub_resource type="Resource" id="Resource_rest"]
script = ExtResource("2_vis")
type = 3
display_name = "Descanso"
banner_text = "Sala de descanso"
description = "Cura al grupo y ningún enemigo aparece aquí."
hint = "Al descubrirla, todos los héroes recuperan vida, y los enemigos no aparecen en ella, esté encendida o no. Un buen sitio para respirar entre combates."
icon = ExtResource("icon_rest")
color = Color(0.45, 0.95, 0.85, 1)
decor_props = Array[Vector2i]([Vector2i(6, 9), Vector2i(7, 9), Vector2i(8, 9), Vector2i(1, 6)])
decor_count = 2

[sub_resource type="Resource" id="Resource_loot"]
script = ExtResource("2_vis")
type = 4
display_name = "Botín"
banner_text = "Sala de botín"
description = "Te da Industria al descubrirla."
hint = "Un cofre con Industria que se cobra al abrir la sala, una sola vez. Gástala en construir módulos de producción y defensa."
icon = ExtResource("icon_loot")
color = Color(1, 0.6, 0.15, 1)
decor_props = Array[Vector2i]([Vector2i(5, 7), Vector2i(6, 7), Vector2i(7, 7)])
decor_count = 2

[sub_resource type="Resource" id="Resource_elite"]
script = ExtResource("2_vis")
type = 5
display_name = "Élite"
banner_text = "Sala de élite"
description = "Enemigos más duros, pero te da Ciencia."
hint = "Los enemigos que aparecen aquí tienen más vida y golpean más fuerte. A cambio, descubrirla te da Ciencia para investigar. Enciéndela para evitar sus oleadas."
icon = ExtResource("icon_elite")
color = Color(0.85, 0.4, 1, 1)
decor_props = Array[Vector2i]([Vector2i(9, 9), Vector2i(10, 9), Vector2i(11, 9), Vector2i(8, 8)])
decor_count = 2

[sub_resource type="Resource" id="Resource_generator"]
script = ExtResource("2_vis")
type = 6
display_name = "Generador"
banner_text = "Sala de generadores"
description = "Dos huecos grandes de construcción."
hint = "Al encenderla ofrece dos huecos grandes de construcción en lugar de uno: ideal para duplicar generadores de Industria, Comida o Ciencia."
icon = ExtResource("icon_generator")
color = Color(0.4, 0.7, 1, 1)
decor_props = Array[Vector2i]([Vector2i(7, 4), Vector2i(8, 4)])
decor_count = 2

[resource]
script = ExtResource("1_cfg")
entries = Array[ExtResource("2_vis")]([SubResource("Resource_start"), SubResource("Resource_exit"), SubResource("Resource_rest"), SubResource("Resource_loot"), SubResource("Resource_elite"), SubResource("Resource_generator")])
