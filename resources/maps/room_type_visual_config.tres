[sub_resource type="Resource" id="Resource_exit"]
script = ExtResource("2_vis")
type = 2
display_name = "Salida"
banner_text = "Salida encontrada"
description = "Lleva la Reliquia hasta aquí para ganar el piso."
hint = "La salida del piso. Recoge la Reliquia en la sala inicial y llévala hasta aquí. Mientras la cargas las puertas se bloquean y llegan oleadas por las salas oscuras."
color = Color(0.35, 1, 0.6, 1)
show_marker = false
light_color = Color(0.6, 1, 0.75, 1)
interior = 4
braziers = 2

[sub_resource type="Resource" id="Resource_rest"]
script = ExtResource("2_vis")
type = 3
display_name = "Descanso"
banner_text = "Sala de descanso"
description = "Cura con el tiempo (cuesta Comida); sin enemigos."
hint = "Los héroes heridos que se quedan aquí recuperan vida poco a poco, gastando 1 de Comida por cada curación. Los enemigos no aparecen en ella, esté encendida o no. Un buen sitio para respirar entre combates."
icon = ExtResource("icon_rest")
color = Color(0.45, 0.95, 0.85, 1)
light_color = Color(1, 0.62, 0.3, 1)
interior = 3
floor_props = Array[Vector2i]([Vector2i(45, 0)])
floor_prop_count = 2
braziers = 1

[sub_resource type="Resource" id="Resource_loot"]
script = ExtResource("2_vis")
type = 4
display_name = "Botín"
banner_text = "Sala de botín"
description = "Un cofre y algo de Hierro."
hint = "Al descubrirla te da Hierro, y guarda un cofre que se abre cuando un héroe entra. El cofre es de madera en los primeros pisos, de hierro en los del medio y de oro en el último: cuanto mejor el cofre, más rara la pieza."
icon = ExtResource("icon_loot")
color = Color(1, 0.6, 0.15, 1)
decor_props = Array[Vector2i]([Vector2i(0, 6), Vector2i(1, 6), Vector2i(6, 4)])
decor_count = 2
light_color = Color(1, 0.85, 0.4, 1)
wall_props = Array[Vector2i]([Vector2i(31, 0)])
wall_prop_count = 1

[sub_resource type="Resource" id="Resource_elite"]
script = ExtResource("2_vis")
type = 5
display_name = "Élite"
banner_text = "Sala de élite"
description = "Enemigos más duros, pero te da Saber."
hint = "Los enemigos que aparecen aquí tienen más vida y golpean más fuerte. A cambio, descubrirla te da Saber para investigar. Enciéndela para evitar sus oleadas."
icon = ExtResource("icon_elite")
color = Color(1, 0.3, 0.28, 1)
