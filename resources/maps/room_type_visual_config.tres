[sub_resource type="Resource" id="Resource_prisoner"]
script = ExtResource("2_vis")
type = 7
display_name = "Prisionero"
banner_text = "Un prisionero"
description = "Un héroe encerrado: liberalo con Hierro o Comida."
hint = "En la celda espera un héroe que no elegiste al empezar. Con un héroe vivo dentro de la sala, hacé clic izquierdo en la celda y pagá Hierro o Comida para liberarlo: se une al grupo (máximo 4) y sigue en los próximos pisos."
icon = ExtResource("icon_prisoner")
color = Color(0.85, 0.55, 1, 1)
light_color = Color(0.75, 0.6, 1, 1)
floor_props = Array[Vector2i]([Vector2i(33, 0), Vector2i(35, 0)])
floor_prop_count = 2
wall_props = Array[Vector2i]([Vector2i(32, 0)])
wall_prop_count = 3

[sub_resource type="Resource" id="Resource_altar"]
script = ExtResource("2_vis")
type = 8
display_name = "Altar"
banner_text = "Altar de sangre"
description = "Vida a cambio de un objeto raro."
hint = "Con un héroe vivo en la sala, hacé clic izquierdo en el altar: ese héroe pierde el 30 % de su vida máxima y el grupo recibe un objeto raro o mejor. Solo acepta una ofrenda, y no si el héroe quedaría caído."
icon = ExtResource("icon_altar")
color = Color(0.7, 0.92, 1, 1)
light_color = Color(0.55, 0.8, 1, 1)
interior = 4
floor_props = Array[Vector2i]([Vector2i(26, 0)])
floor_prop_count = 4
wall_props = Array[Vector2i]([Vector2i(30, 0)])
wall_prop_count = 1

[sub_resource type="Resource" id="Resource_secret"]
script = ExtResource("2_vis")
type = 9
display_name = "Secreta"
banner_text = "¡Sala secreta!"
description = "Brasas y un cofre poco común o mejor."
hint = "Una sala sin puerta. Se revela sola cuando descubrís las dos salas que la rodean. Da Brasas y guarda un cofre que nunca es común, y ningún enemigo aparece en ella."
icon = ExtResource("icon_secret")
color = Color(1, 0.85, 0.35, 1)
light_color = Color(1, 0.8, 0.45, 1)
floor_props = Array[Vector2i]([Vector2i(43, 0), Vector2i(44, 0)])
floor_prop_count = 5

