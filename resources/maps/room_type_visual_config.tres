floor_prop_count = 4
wall_props = Array[Vector2i]([Vector2i(32, 0)])
wall_prop_count = 1
braziers = 2

[sub_resource type="Resource" id="Resource_workshop"]
script = ExtResource("2_vis")
type = 6
display_name = "Taller"
banner_text = "Sala de talleres"
description = "Dos huecos grandes de construcción."
hint = "Al encenderla ofrece dos huecos grandes de construcción en lugar de uno: ideal para duplicar talleres de Hierro, Comida o Saber."
